{
  "expo": {
    "name": "SpaceVerse",
    "slug": "spaceverse",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "scheme": "spaceverse",
    "assetBundlePatterns": [
      "assets/*.xjpg",
      "assets/*.xpng"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050816"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
